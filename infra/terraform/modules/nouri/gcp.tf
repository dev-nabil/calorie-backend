locals {
  name = "nouri-${var.environment}"
  # Secrets generated by Terraform (stored in Secret Manager; state must be encrypted and private).
  generated_secrets = ["JWT_ACCESS_SECRET", "JWT_REFRESH_SECRET", "OTP_PEPPER", "LEDGER_PEPPER", "CDN_SIGNING_KEY"]
  all_secrets       = concat(local.generated_secrets, ["MONGODB_URI_API", "MONGODB_URI_WORKER", "REDIS_URL"], var.external_secrets)
  common_env = merge({
    NODE_ENV         = "production"
    STORAGE_DRIVER   = "s3"
    S3_ENDPOINT      = "https://${var.cloudflare_account_id}.r2.cloudflarestorage.com"
    S3_REGION        = "auto"
    S3_BUCKET        = cloudflare_r2_bucket.media.name
    CDN_BASE_URL     = var.cdn_base_url
    EMAIL_DRIVER     = "resend"
    AI_PROVIDER      = "openai"
    INTEGRITY_DRIVER = "device"
    TRUST_PROXY      = "2"
    CORS_ORIGINS     = join(",", var.cors_origins)
    ADMIN_APP_URL    = var.admin_app_url
    SWAGGER_ENABLED  = var.environment == "prod" ? "false" : "true"
    APP_VERSION      = var.image
  }, var.plain_env)
  # Secrets shared by both roles; MONGODB_URI differs per role (one DB user per app).
  shared_secret_env = [for s in local.all_secrets : s if !startswith(s, "MONGODB_URI_")]
}

resource "google_artifact_registry_repository" "nouri" {
  project       = var.gcp_project_id
  location      = var.gcp_region
  repository_id = "nouri"
  format        = "DOCKER"
  description   = "nouri-backend images (api and worker share one image)"
  cleanup_policies {
    id     = "keep-recent"
    action = "KEEP"
    most_recent_versions {
      keep_count = 30
    }
  }
  depends_on = [google_project_service.services]
}

# --- Service accounts (least privilege) -------------------------------------------------------
resource "google_service_account" "api" {
  project      = var.gcp_project_id
  account_id   = "${local.name}-api"
  display_name = "Nouri API (${var.environment})"
}

resource "google_service_account" "worker" {
  project      = var.gcp_project_id
  account_id   = "${local.name}-worker"
  display_name = "Nouri worker (${var.environment})"
}

resource "google_service_account" "deployer" {
  project      = var.gcp_project_id
  account_id   = "${local.name}-deploy"
  display_name = "GitHub Actions deployer (${var.environment})"
}

resource "google_project_iam_member" "deployer" {
  for_each = toset(["roles/run.developer", "roles/artifactregistry.writer"])
  project  = var.gcp_project_id
  role     = each.value
  member   = "serviceAccount:${google_service_account.deployer.email}"
}

resource "google_service_account_iam_member" "deployer_acts_as" {
  for_each           = { api = google_service_account.api.name, worker = google_service_account.worker.name }
  service_account_id = each.value
  role               = "roles/iam.serviceAccountUser"
  member             = "serviceAccount:${google_service_account.deployer.email}"
}

# --- Workload Identity Federation for GitHub Actions (no JSON keys) ---------------------------
resource "google_iam_workload_identity_pool" "github" {
  project                   = var.gcp_project_id
  workload_identity_pool_id = "${local.name}-github"
  display_name              = "GitHub (${var.environment})"
}

resource "google_iam_workload_identity_pool_provider" "github" {
  project                            = var.gcp_project_id
  workload_identity_pool_id          = google_iam_workload_identity_pool.github.workload_identity_pool_id
  workload_identity_pool_provider_id = "github"
  attribute_mapping = {
    "google.subject"       = "assertion.sub"
    "attribute.repository" = "assertion.repository"
    "attribute.ref"        = "assertion.ref"
  }
  attribute_condition = "assertion.repository == '${var.github_repository}'"
  oidc {
    issuer_uri = "https://token.actions.githubusercontent.com"
  }
}

resource "google_service_account_iam_member" "github_deployer" {
  service_account_id = google_service_account.deployer.name
  role               = "roles/iam.workloadIdentityUser"
  member             = "principalSet://iam.googleapis.com/${google_iam_workload_identity_pool.github.name}/attribute.repository/${var.github_repository}"
}

# --- Secret Manager ---------------------------------------------------------------------------
resource "google_secret_manager_secret" "secrets" {
  for_each  = toset(local.all_secrets)
  project   = var.gcp_project_id
  secret_id = "${local.name}-${each.value}"
  replication {
    auto {}
  }
  depends_on = [google_project_service.services]
}

resource "random_password" "generated" {
  for_each = toset(local.generated_secrets)
  length   = 64
  special  = false
}

resource "google_secret_manager_secret_version" "generated" {
  for_each    = toset(local.generated_secrets)
  secret      = google_secret_manager_secret.secrets[each.value].id
  secret_data = random_password.generated[each.value].result
}

resource "google_secret_manager_secret_version" "redis_url" {
  secret      = google_secret_manager_secret.secrets["REDIS_URL"].id
  secret_data = "redis://:${google_redis_instance.main.auth_string}@${google_redis_instance.main.host}:${google_redis_instance.main.port}"
}

resource "google_secret_manager_secret_iam_member" "access" {
  for_each = {
    for pair in setproduct(local.all_secrets, ["api", "worker"]) : "${pair[0]}:${pair[1]}" => { secret = pair[0], role = pair[1] }
    if !(pair[0] == "MONGODB_URI_API" && pair[1] == "worker") && !(pair[0] == "MONGODB_URI_WORKER" && pair[1] == "api")
  }
  project   = var.gcp_project_id
  secret_id = google_secret_manager_secret.secrets[each.value.secret].secret_id
  role      = "roles/secretmanager.secretAccessor"
  member    = "serviceAccount:${each.value.role == "api" ? google_service_account.api.email : google_service_account.worker.email}"
}

# --- Memorystore Redis (BullMQ, idempotency, rate limits, revocation) -------------------------
resource "google_redis_instance" "main" {
  project            = var.gcp_project_id
  name               = local.name
  region             = var.gcp_region
  tier               = var.redis_tier
  memory_size_gb     = var.redis_memory_gb
  redis_version      = "REDIS_7_2"
  authorized_network = google_compute_network.main.id
  auth_enabled       = true
  redis_configs      = { "maxmemory-policy" = "noeviction" } # BullMQ requires noeviction
  depends_on         = [google_project_service.services]
}

# --- Cloud Run: api and worker from the same image --------------------------------------------
resource "google_cloud_run_v2_service" "api" {
  project             = var.gcp_project_id
  name                = "nouri-api-${var.environment}"
  location            = var.gcp_region
  ingress             = "INGRESS_TRAFFIC_ALL" # Cloudflare in front; see README for locking to Cloudflare
  deletion_protection = var.deletion_protection

  template {
    service_account                  = google_service_account.api.email
    max_instance_request_concurrency = 80
    timeout                          = "60s"
    scaling {
      min_instance_count = var.api_min_instances
      max_instance_count = var.api_max_instances
    }
    vpc_access {
      egress = "PRIVATE_RANGES_ONLY"
      network_interfaces {
        network    = google_compute_network.main.id
        subnetwork = google_compute_subnetwork.run.id
      }
    }
    containers {
      image = var.image
      ports {
        container_port = 8080
      }
      resources {
        limits            = { cpu = "1", memory = "1Gi" }
        startup_cpu_boost = true
      }
      env {
        name  = "ROLE"
        value = "api"
      }
      dynamic "env" {
        for_each = local.common_env
        content {
          name  = env.key
          value = env.value
        }
      }
      env {
        name = "MONGODB_URI"
        value_source {
          secret_key_ref {
            secret  = google_secret_manager_secret.secrets["MONGODB_URI_API"].secret_id
            version = "latest"
          }
        }
      }
      dynamic "env" {
        for_each = toset(local.shared_secret_env)
        content {
          name = env.value
          value_source {
            secret_key_ref {
              secret  = google_secret_manager_secret.secrets[env.value].secret_id
              version = "latest"
            }
          }
        }
      }
      startup_probe {
        http_get {
          path = "/v1/health"
        }
        period_seconds    = 5
        failure_threshold = 12
      }
      liveness_probe {
        http_get {
          path = "/v1/health"
        }
        period_seconds = 30
      }
    }
  }

  lifecycle {
    ignore_changes = [template[0].containers[0].image, client, client_version] # CI deploys new images
  }
  depends_on = [google_secret_manager_secret_iam_member.access, google_secret_manager_secret_version.generated]
}

resource "google_cloud_run_v2_service_iam_member" "api_public" {
  project  = var.gcp_project_id
  location = var.gcp_region
  name     = google_cloud_run_v2_service.api.name
  role     = "roles/run.invoker"
  member   = "allUsers"
}

resource "google_cloud_run_v2_service" "worker" {
  project             = var.gcp_project_id
  name                = "nouri-worker-${var.environment}"
  location            = var.gcp_region
  ingress             = "INGRESS_TRAFFIC_INTERNAL_ONLY" # only /v1/health; no public traffic
  deletion_protection = var.deletion_protection

  template {
    service_account = google_service_account.worker.email
    scaling {
      min_instance_count = var.worker_min_instances
      max_instance_count = var.worker_max_instances
    }
    vpc_access {
      egress = "PRIVATE_RANGES_ONLY"
      network_interfaces {
        network    = google_compute_network.main.id
        subnetwork = google_compute_subnetwork.run.id
      }
    }
    containers {
      image = var.image
      ports {
        container_port = 8080
      }
      resources {
        limits   = { cpu = "1", memory = "1Gi" }
        cpu_idle = false # always-on CPU: BullMQ consumers and schedulers run between requests
      }
      env {
        name  = "ROLE"
        value = "worker"
      }
      dynamic "env" {
        for_each = local.common_env
        content {
          name  = env.key
          value = env.value
        }
      }
      env {
        name = "MONGODB_URI"
        value_source {
          secret_key_ref {
            secret  = google_secret_manager_secret.secrets["MONGODB_URI_WORKER"].secret_id
            version = "latest"
          }
        }
      }
      dynamic "env" {
        for_each = toset(local.shared_secret_env)
        content {
          name = env.value
          value_source {
            secret_key_ref {
              secret  = google_secret_manager_secret.secrets[env.value].secret_id
              version = "latest"
            }
          }
        }
      }
      startup_probe {
        http_get {
          path = "/v1/health"
        }
        period_seconds    = 5
        failure_threshold = 12
      }
    }
  }

  lifecycle {
    ignore_changes = [template[0].containers[0].image, client, client_version]
  }
  depends_on = [google_secret_manager_secret_iam_member.access, google_secret_manager_secret_version.generated]
}

# Custom domain for the API (Cloudflare proxies to ghs.googlehosted.com; SSL mode Full (strict)).
resource "google_cloud_run_domain_mapping" "api" {
  project  = var.gcp_project_id
  location = var.gcp_region
  name     = var.api_hostname
  metadata {
    namespace = var.gcp_project_id
  }
  spec {
    route_name = google_cloud_run_v2_service.api.name
  }
}
