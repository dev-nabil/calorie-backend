{
  "name": "nouri-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Nouri NestJS API and BullMQ worker (ROLE=api|worker)",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:worker": "ROLE=worker nest start --watch",
    "start:prod:worker": "ROLE=worker node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "content:validate": "node content/scripts/validate.mjs",
    "test": "pnpm content:validate && jest",
    "test:unit": "jest --selectProjects unit",
    "test:e2e": "jest --selectProjects e2e",
    "test:cov": "jest --coverage",
    "openapi": "tsc -p tsconfig.build.json && node dist/openapi.js",
    "start:local": "tsc -p tsconfig.build.json && node dist/dev/local.js",
    "plan:smoke": "tsc -p tsconfig.build.json && node dist/dev/plan-smoke.js",
    "env:doctor": "tsc -p tsconfig.build.json && node dist/dev/env-doctor.js",
    "admin:seed":"tsc -p tsconfig.build.json && node dist/dev/admin-seed.js",
    "eval:meal-scan": "tsc -p tsconfig.build.json && node dist/evals/meal-scan.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/mongoose": "11.0.4",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.82.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "bullmq": "5.81.5",
    "disposable-email-domains": "1.0.62",
    "google-auth-library": "11.3.2",
    "ioredis": "5.11.1",
    "jose": "6.2.15",
    "mongoose": "9.11.4",
    "nestjs-pino": "5.3.1",
    "openai": "7.47.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@swc/core": "1.16.21",
    "@swc/jest": "0.2.39",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "mongodb-memory-server": "11.3.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "mongodb-memory-server",
      "msgpackr-extract",
      "@nestjs/core"
    ]
  }
}
