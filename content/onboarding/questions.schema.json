{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nouri.app/schemas/onboarding/questions.schema.json",
  "title": "Nouri onboarding question bank",
  "description": "Schema for content/onboarding/questions.v<N>.json. Option IDs, question IDs and field keys are stable forever; display copy may change.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "locale", "conditionGrammar", "engine", "valueFormats", "stages", "routes", "branching", "reviewSections", "review", "questions"],
  "properties": {
    "$schema": { "type": "string" },
    "kind": { "const": "onboarding_questions" },
    "version": { "type": "integer", "minimum": 1 },
    "locale": { "type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$" },
    "source": { "type": "object", "additionalProperties": { "type": "string" } },
    "placeholders": { "type": "object", "additionalProperties": { "type": "string" } },
    "conditionGrammar": {
      "type": "object",
      "required": ["forms"],
      "properties": {
        "description": { "type": "string" },
        "forms": { "type": "object", "additionalProperties": { "type": "string" } },
        "ageDerivation": { "type": "string" },
        "missingValue": { "type": "string" }
      },
      "additionalProperties": false
    },
    "engine": { "type": "object", "additionalProperties": { "type": "string" } },
    "valueFormats": { "type": "object", "additionalProperties": { "type": "string" } },
    "stages": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "key", "label", "questionIds"],
        "properties": {
          "id": { "type": "integer", "minimum": 1, "maximum": 7 },
          "key": { "$ref": "#/$defs/slug" },
          "label": { "$ref": "#/$defs/copy" },
          "questionIds": { "type": "array", "items": { "$ref": "#/$defs/questionId" }, "uniqueItems": true }
        }
      }
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basic", "detailed", "conversation"],
      "properties": {
        "basic": { "$ref": "#/$defs/route" },
        "detailed": { "$ref": "#/$defs/route" },
        "conversation": {
          "allOf": [{ "$ref": "#/$defs/route" }],
          "required": ["ref"]
        }
      }
    },
    "branching": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "show", "when", "onHide"],
        "properties": {
          "id": { "type": "string", "pattern": "^BR-[A-Z0-9]+$" },
          "show": { "$ref": "#/$defs/questionId" },
          "when": { "$ref": "#/$defs/condition" },
          "onHide": {
            "type": "object",
            "additionalProperties": false,
            "required": ["clear", "effects"],
            "properties": {
              "clear": { "type": "array", "items": { "$ref": "#/$defs/questionId" } },
              "effects": {
                "type": "array",
                "items": { "enum": ["habits_only_mode", "disable_targets", "never_reuse_old_target", "calculation_incomplete", "disable_fasting_suggestions", "hide_movement_setup"] }
              }
            }
          },
          "source": { "type": "string" }
        }
      }
    },
    "reviewSections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "questionIds"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "label": { "$ref": "#/$defs/copy" },
          "questionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/questionId" } }
        }
      }
    },
    "review": { "type": "object", "additionalProperties": { "type": "string" } },
    "questions": {
      "type": "array",
      "minItems": 35,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "questionId": { "type": "string", "pattern": "^(q[0-9]{2}|[a-z][a-z0-9_]*)$" },
    "optionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$", "maxLength": 32 },
    "copy": { "type": "string", "minLength": 1, "maxLength": 240 },
    "route": {
      "type": "object",
      "required": ["label", "sub", "icon", "questionIds", "then"],
      "properties": {
        "label": { "$ref": "#/$defs/copy" },
        "sub": { "$ref": "#/$defs/copy" },
        "icon": { "type": "string" },
        "questionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/questionId" } },
        "then": { "const": "review" },
        "ref": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "oneOf": [
        { "required": ["all"], "properties": { "all": { "type": "array", "items": { "$ref": "#/$defs/condition" } } }, "additionalProperties": false },
        { "required": ["any"], "properties": { "any": { "type": "array", "items": { "$ref": "#/$defs/condition" } } }, "additionalProperties": false },
        { "required": ["not"], "properties": { "not": { "$ref": "#/$defs/condition" } }, "additionalProperties": false },
        { "required": ["q", "eq"], "properties": { "q": { "$ref": "#/$defs/questionId" }, "eq": { "$ref": "#/$defs/optionId" } }, "additionalProperties": false },
        { "required": ["q", "in"], "properties": { "q": { "$ref": "#/$defs/questionId" }, "in": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/optionId" } } }, "additionalProperties": false },
        { "required": ["q", "includes"], "properties": { "q": { "$ref": "#/$defs/questionId" }, "includes": { "$ref": "#/$defs/optionId" } }, "additionalProperties": false },
        { "required": ["q", "eqSet"], "properties": { "q": { "$ref": "#/$defs/questionId" }, "eqSet": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/optionId" } } }, "additionalProperties": false },
        { "required": ["q", "answered"], "properties": { "q": { "$ref": "#/$defs/questionId" }, "answered": { "type": "boolean" } }, "additionalProperties": false },
        {
          "required": ["age"],
          "properties": {
            "age": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "properties": { "gte": { "type": "integer" }, "gt": { "type": "integer" }, "lte": { "type": "integer" }, "lt": { "type": "integer" } }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["route"],
          "properties": {
            "route": {
              "oneOf": [
                { "enum": ["basic", "detailed", "conversation"] },
                { "type": "object", "required": ["in"], "additionalProperties": false, "properties": { "in": { "type": "array", "minItems": 1, "items": { "enum": ["basic", "detailed", "conversation"] } } } }
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "icon", "freeText"],
      "properties": {
        "id": { "$ref": "#/$defs/optionId" },
        "label": { "$ref": "#/$defs/copy" },
        "shortLabel": { "$ref": "#/$defs/copy" },
        "icon": { "type": ["string", "null"], "pattern": "^[a-z][a-z-]*$" },
        "freeText": { "type": "boolean" },
        "opensInfo": { "type": "string" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "min", "max", "unit"],
          "properties": {
            "type": { "const": "number" },
            "min": { "type": "integer" },
            "max": { "type": "integer" },
            "start": { "type": "integer" },
            "unit": { "type": "string" },
            "integer": { "type": "boolean" }
          }
        }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "short", "label"],
      "properties": {
        "id": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] },
        "short": { "type": "string", "maxLength": 2 },
        "label": { "$ref": "#/$defs/copy" }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fieldKey", "order", "stage", "version", "type", "required", "max", "exclusive", "reviewLabel", "text", "note", "miloLine", "miloLineNoName", "hint", "skipLabel", "display", "options", "days", "limits"],
      "properties": {
        "id": { "$ref": "#/$defs/questionId" },
        "fieldKey": { "$ref": "#/$defs/slug" },
        "order": { "type": "integer", "minimum": 1 },
        "stage": { "type": "integer", "minimum": 1, "maximum": 6 },
        "version": { "type": "integer", "minimum": 1 },
        "type": { "enum": ["single", "multi", "text", "age", "height", "weight", "days", "number"] },
        "required": { "type": "boolean" },
        "max": { "type": ["integer", "null"], "minimum": 1 },
        "exclusive": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/optionId" } },
        "reviewLabel": { "$ref": "#/$defs/copy" },
        "text": { "$ref": "#/$defs/copy" },
        "note": { "type": ["string", "null"], "maxLength": 240 },
        "miloLine": { "$ref": "#/$defs/copy" },
        "miloLineNoName": { "type": ["string", "null"], "maxLength": 240 },
        "hint": { "enum": ["Required", "Optional", "Choose any that apply", "Choose up to 2", "Choose up to 3", "Select weekdays"] },
        "skipLabel": { "type": ["string", "null"], "maxLength": 60 },
        "display": {
          "type": "object",
          "additionalProperties": false,
          "required": ["layout", "grid"],
          "properties": {
            "layout": { "enum": ["list", "chips"] },
            "grid": { "type": "array", "items": { "$ref": "#/$defs/optionId" } }
          }
        },
        "options": { "type": "array", "items": { "$ref": "#/$defs/option" } },
        "days": { "type": "array", "items": { "$ref": "#/$defs/day" } },
        "limits": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "maxLength": { "type": "integer", "minimum": 1 },
            "trim": { "type": "boolean" },
            "unicode": { "type": "boolean" },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "unit": { "enum": ["years", "cm", "kg"] },
            "adultFrom": { "type": "integer" },
            "dobNotInFuture": { "type": "boolean" },
            "modes": { "type": "array", "items": { "enum": ["dob", "age", "none"] } },
            "displayUnits": { "type": "array", "items": { "enum": ["cm", "ft_in", "kg", "lb"] } },
            "step": { "type": "object", "additionalProperties": { "type": "number" } },
            "bigStepMultiplier": { "type": "integer" },
            "estimateFlag": { "type": "boolean" },
            "start": { "type": ["number", "null"] },
            "customDays": {
              "type": "object",
              "additionalProperties": false,
              "required": ["min", "max"],
              "properties": { "min": { "type": "integer" }, "max": { "type": "integer" } }
            }
          }
        }
      }
    }
  }
}
