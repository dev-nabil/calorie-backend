# nouri-backend environment (validated at boot by src/config/env.ts).
# Only secrets, the database URL and what the server needs before it can read the database live here.
# Everything else (models, scan caps, sign-in client IDs, email sender, integrity, barcode lookups,
# admin panel URL) is an admin setting: admin panel → Settings (stored in MongoDB, app_config).
#
# Copy to .env and fill in. `KEY=` (empty) is the same as unset. Check with:  pnpm env:doctor
# Never commit .env or paste real credentials in this file.

NODE_ENV=development          # development | production (test is for the test suites)
PORT=3000
LOG_LEVEL=info

# ── Database (required) ────────────────────────────────────────────────────
# Atlas: keep the database name (/nouri) in the URI, otherwise data lands in the "test" database.
# MongoDB also holds the key-value store, the background job queue and the admin settings: no Redis.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nouri?retryWrites=true&w=majority

# ── Secrets (required in production) ───────────────────────────────────────
# Generate once with:  pnpm env:doctor --init-secrets   (or: openssl rand -hex 32)
# Empty falls back to a public dev default, so set them BEFORE the first real user or admin exists.
# Changing them later signs everyone out; OTP_PEPPER also encrypts admin TOTP secrets
# (admins must be re-seeded); LEDGER_PEPPER guards the free-scan ledger: never rotate it.
JWT_ACCESS_SECRET=            # >= 32 chars
JWT_REFRESH_SECRET=           # >= 32 chars
OTP_PEPPER=                   # >= 16 chars
LEDGER_PEPPER=                # >= 16 chars

# Google Gemini: the one key for every AI feature (plan tips, coach, live voice, photo and label scans).
# Server only: never in the apps, never committed. Use a key from a project with billing on.
# Empty (development only) = plan tips, live voice and scans say AI is not switched on.
GEMINI_API_KEY=

# Resend: real sign-in emails. Empty (development only) = codes are printed in the log.
# The sender address is the admin setting email.from (its domain must be verified in Resend).
EMAIL_API_KEY=

# Cloudflare Turnstile (waitlist form). Empty (development only) = any token passes.
TURNSTILE_SECRET=

# Billing and push (needed only when those features go live)
REVENUECAT_API_KEY=           # empty = stub verifier
REVENUECAT_WEBHOOK_SECRET=
# FCM: Firebase console → Project settings → Service accounts → Generate new private key; the whole
# file on ONE line inside SINGLE quotes (keeps the "\n" escapes in private_key). Empty = reminders are logged.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Play Integrity decoder (Android). The package name is the admin setting integrity.android.package.
PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=

# ── Photo storage ──────────────────────────────────────────────────────────
# Bucket + both keys set = S3-compatible storage (Cloudflare R2 free tier works); required in production.
# Unset = local disk (LOCAL_STORAGE_DIR): fine for development, wiped on every Render deploy.
S3_ENDPOINT=                  # e.g. https://<account>.r2.cloudflarestorage.com
S3_REGION=                    # auto for R2
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=                 # optional signed CDN in front of the bucket
CDN_SIGNING_KEY=
LOCAL_STORAGE_DIR=.local/uploads

# ── HTTP ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=                 # comma-separated browser origins (website + admin panel); defaults to http://localhost:3001 outside production
TRUST_PROXY=                  # behind a proxy: hop count (1 on Render) or CIDR list, never "true"
OTEL_EXPORTER_OTLP_ENDPOINT=  # optional traces and metrics

# ── Development only (refused or ignored in production) ─────────────────────
DEV_ROUTES=                   # /v1/dev/* helpers; default on in development. Never on a public URL.
SWAGGER_ENABLED=              # /docs; default on outside production
ADMIN_TOTP_REQUIRED=          # false = admin sign-in skips the authenticator code
DEV_FIXED_OTP=                # e.g. 000000: every email sign-in code is this value (not with EMAIL_API_KEY)
