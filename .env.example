# nouri-backend environment (validated at boot by src/config/env.ts).
# Copy to .env and fill in. `KEY=` (empty) is the same as unset: the default applies.
# Check what is real and what is still fake with:  pnpm env:doctor
# Never commit .env or paste real credentials in this file.

NODE_ENV=development
PORT=3000
ROLE=api                      # api | worker (same image, two deployables)
LOG_LEVEL=info
APP_VERSION=0.1.0

# ── 1. Data stores (real) ──────────────────────────────────────────────────
# Atlas: keep the database name (/nouri) in the URI, otherwise data lands in the "test" database.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nouri?retryWrites=true&w=majority
# Local: brew services start redis (or docker compose -f infra/docker-compose.yml up -d).
# Empty = in-memory store, no BullMQ worker, scans run inline (dev and tests only; required in production).
REDIS_URL=redis://localhost:6379

# ── 2. Secrets ─────────────────────────────────────────────────────────────
# Generate once with:  pnpm env:doctor --init-secrets   (or: openssl rand -hex 32)
# Empty falls back to a public dev default, so set them BEFORE the first real user or admin exists.
# Changing them later signs everyone out; OTP_PEPPER also encrypts admin TOTP secrets
# (admins must be re-seeded); LEDGER_PEPPER guards the free-scan ledger: never rotate it.
JWT_ACCESS_SECRET=            # >= 32 chars
JWT_REFRESH_SECRET=           # >= 32 chars
OTP_PEPPER=                   # >= 16 chars
LEDGER_PEPPER=                # >= 16 chars, HMAC key for scan_ledger (S-14)

# ── 3. Email: sign-in codes, data export (real) ────────────────────────────
EMAIL_DRIVER=console          # console | memory | resend. Set resend for real mail (required in production).
EMAIL_API_KEY=                # Resend API key
EMAIL_FROM="Nouri <hello@your-domain>"   # must be a domain verified in Resend

# ── 4. AI (real) ───────────────────────────────────────────────────────────
# To switch on every AI feature, including personalised plan tips:
#   1. AI_PROVIDER=openai
#   2. OPENAI_API_KEY=<your key>   (server only: never in the apps, never committed; .env is git-ignored)
#   3. restart the API (and the worker if you run one), then  pnpm plan:smoke  and  pnpm env:doctor
# While the key is empty everything still runs: plans keep their validated calorie and macro targets and
# the app says personalised tips are not switched on. Nothing is faked.
AI_PROVIDER=fake              # fake | openai. Set openai for real scans (fake is refused in production).
OPENAI_API_KEY=
OPENAI_PLAN_MODEL=            # optional. Model for plan tips; empty = gpt-5-mini. The admin setting ai.model.plan wins.
# Milo's live voice conversation (OpenAI Realtime over WebRTC). The phone talks to OpenAI directly with a short-lived
# secret that POST /v1/conversations/{id}/realtime mints, so the key above is all that is needed on the server.
# Empty = gpt-realtime-2.1 (best Bangla); gpt-realtime-2.1-mini is about a third of the price. The admin setting
# ai.model.realtime wins. Switch the feature off with the flag voice.realtime. A session costs roughly $0.10-0.30:
# size OPENAI_MONTHLY_BUDGET_USD for it (the app reports each session's tokens, the budget guard counts them).
OPENAI_REALTIME_MODEL=
OPENAI_MONTHLY_BUDGET_USD=    # e.g. 20. The budget guard turns AI off at 95% of it.

# ── 5. Social sign-in ──────────────────────────────────────────────────────
# Google sign-in: the ID token audience the API accepts, comma-separated. The apps pass the
# project's WEB client as serverClientId on iOS and Android, so that one is the audience.
# Firebase project calorie-scanner-9b567 (Authentication → Sign-in method → Google → Web SDK
# configuration): 110926860028-6mpqr1u59dl1hnl7olnhckel3beak0b2.apps.googleusercontent.com
# Empty = fake verifier (local dev). Set it in every deployed environment.
GOOGLE_CLIENT_IDS=
APPLE_BUNDLE_ID=
APPLE_SERVICE_ID=

# ── 6. Photo storage ───────────────────────────────────────────────────────
STORAGE_DRIVER=local          # local (.local/uploads) | s3 (required in production). Local is fine for real data in dev.
LOCAL_STORAGE_DIR=.local/uploads
S3_ENDPOINT=                  # R2 / S3 / MinIO endpoint
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=
CDN_SIGNING_KEY=

# ── 7. Billing and push (needed only when those features go live) ──────────
REVENUECAT_API_KEY=           # server-side purchase verification; empty = stub verifier
REVENUECAT_WEBHOOK_SECRET=
# FCM reminders (DEC-12). Empty = reminders are logged by the console driver, not delivered.
# Firebase console → Project settings → Service accounts → Generate new private key, then put
# the whole file on ONE line inside SINGLE quotes. Single quotes keep the "\n" escapes in
# private_key literal, which JSON.parse turns into newlines (double quotes would break it).
# The client apps use the same project: calorie-scanner-9b567 (FCM sends need its service account).
# Real value: only in .env (git-ignored) or the deploy secret store. Never commit the key.
# Shape (leave the variable below empty here; a filled value switches on the real FCM sender):
#   FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"calorie-scanner-9b567","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-fbsvc@calorie-scanner-9b567.iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}'
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── 8. Device integrity and bot checks ─────────────────────────────────────
INTEGRITY_DRIVER=allow        # allow | device (device = App Attest on iOS + Play Integrity on Android; required in production)
INTEGRITY_ENFORCE=            # defaults to true in production, false elsewhere
APPLE_APP_ATTEST_TEAM_ID=
APP_ATTEST_ALLOW_DEVELOPMENT=   # true to accept development App Attest builds
PLAY_INTEGRITY_PACKAGE=
PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=
TURNSTILE_SECRET=             # Cloudflare Turnstile; required in production, any token accepted when empty

# ── 9. HTTP and ops ────────────────────────────────────────────────────────
FREE_SCANS=1
CORS_ORIGINS=                 # comma-separated; defaults to http://localhost:3001,http://localhost:3002 outside production
ADMIN_APP_URL=http://localhost:3002
TRUST_PROXY=                  # production only: hop count or CIDR list, never "true"
SWAGGER_ENABLED=              # defaults to true outside production (/docs, /docs-json)
CONTENT_DIR=                  # defaults to ./content
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Admin sign-in without the authenticator code (TOTP). Development only: must stay true in production.
ADMIN_TOTP_REQUIRED=true
